rules_version = '2';

// YUNO security rules.
// Paste this whole file into Firebase > Firestore Database > Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin logins' User UIDs (from Firebase > Authentication > Users).
    // First: your new Gmail. Second: your old admin login, kept so you can't get locked out.
    // To remove the old one later, delete it from this list and publish again.
    function adminUids() { return ['TMEmAwS7H5O70tHMyMhm1TJINh52', 'ZTLPHkeWeBXEfzkYiGTtz0U38Wl1']; }

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid in adminUids(); }
    function isStaff(cafeId) {
      return isAdmin() ||
        (signedIn() && exists(/databases/$(database)/documents/cafes/$(cafeId)/staff/$(request.auth.uid)));
    }
    // A waiter login. It can take table orders, mark food served and collect payment. Nothing else.
    function isWaiter(cafeId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/cafes/$(cafeId)/waiters/$(request.auth.uid));
    }
    function cafe(cafeId) { return get(/databases/$(database)/documents/cafes/$(cafeId)).data; }

    // A new order from a customer's phone must look exactly like a real order.
    function validNewOrder(cafeId) {
      let d = request.resource.data;
      let c = cafe(cafeId);
      return c.acceptingOrders == true
        && d.keys().hasOnly(['table', 'items', 'note', 'total', 'status', 'createdAt'])
        && d.keys().hasAll(['table', 'items', 'total', 'status', 'createdAt'])
        && d.status == 'new'
        && d.table is int && d.table >= 1 && d.table <= c.tables
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
        && d.total is number && d.total >= 0 && d.total <= 100000
        && (!('note' in d) || (d.note is string && d.note.size() <= 200))
        && d.createdAt == request.time;
    }

    // A game score from a customer's phone.
    function validScore(sid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['pg', 'game', 'period', 'name', 'pidh', 'table', 'score', 'at'])
        && d.game in ['stack', 'rush']
        && d.period is string && d.period.size() == 11
        && d.pg == d.period + '_' + d.game
        && d.pidh is string && d.pidh.size() == 16
        && sid == d.pg + '_' + d.pidh
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 14
        && d.table is int && d.table >= 0 && d.table <= 100
        && d.score is int && d.score >= 1 && d.score <= (d.game == 'stack' ? 500 : 99999)
        && d.at == request.time;
    }

    // An order typed in by cafe staff (parcel, walk-in, or table).
    function validStaffOrder() {
      let d = request.resource.data;
      return d.items is list && d.items.size() >= 1 && d.items.size() <= 60
        && d.table is int && d.table >= 0 && d.table <= 100
        && d.status in ['new', 'preparing', 'ready', 'served']
        && d.createdAt == request.time;
    }

    // An order typed in by a waiter. It starts as "new", so the counter or kitchen has to accept it.
    function validWaiterOrder(cafeId) {
      let d = request.resource.data;
      let c = cafe(cafeId);
      return d.keys().hasOnly(['table', 'items', 'note', 'total', 'status', 'createdAt', 'source', 'waiterUid', 'waiterName'])
        && d.keys().hasAll(['table', 'items', 'total', 'status', 'createdAt', 'source', 'waiterUid'])
        && d.source == 'waiter' && d.waiterUid == request.auth.uid
        && d.status == 'new'
        && d.table is int && d.table >= 1 && d.table <= c.tables
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
        && d.total is number && d.total >= 0 && d.total <= 100000
        && (!('note' in d) || (d.note is string && d.note.size() <= 200))
        && (!('waiterName' in d) || (d.waiterName is string && d.waiterName.size() <= 40))
        && d.createdAt == request.time;
    }

    // The only changes a waiter can make to an existing order.
    function waiterMayChangeOrder() {
      let a = resource.data;
      let b = request.resource.data;
      let changed = b.diff(a).affectedKeys();
      return
        // Food was served.
        (changed.hasOnly(['status', 'updatedAt']) && a.status == 'ready' && b.status == 'served')
        // Payment taken: link the bill (only once).
        || (changed.hasOnly(['billId', 'updatedAt']) && !('billId' in a) && b.billId is string)
        // Cancel an order this waiter sent, before the kitchen or counter accepts it.
        || (changed.hasOnly(['status', 'cancelledBy', 'cancelReason', 'updatedAt'])
            && a.status == 'new' && a.get('waiterUid', '') == request.auth.uid
            && b.status == 'cancelled' && b.cancelledBy == 'waiter'
            && b.cancelReason is string && b.cancelReason.size() <= 120);
    }

    // A bill saved by a waiter when taking payment. No discounts, and it can't be a voided bill.
    function validWaiterBill() {
      let d = request.resource.data;
      return d.keys().hasOnly(['billNo', 'label', 'name', 'type', 'tables', 'orderIds', 'lines', 'subtotal', 'discount', 'gstPct', 'gst', 'roundOff', 'total', 'pay', 'void', 'createdAt', 'by'])
        && d.keys().hasAll(['billNo', 'orderIds', 'lines', 'discount', 'total', 'pay', 'void', 'createdAt', 'by'])
        && d.by == request.auth.uid && d.void == false && d.discount == 0
        && d.pay in ['cash', 'upi', 'card']
        && d.billNo is int && d.billNo >= 1
        && d.total is number && d.total >= 0 && d.total <= 1000000
        && d.orderIds is list && d.orderIds.size() >= 1 && d.orderIds.size() <= 60
        && d.lines is list && d.lines.size() >= 1 && d.lines.size() <= 60
        && d.createdAt == request.time;
    }

    // Only the admin can read this. The admin page uses it to check who is signed in.
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    // Which cafes each staff login belongs to.
    match /staffIndex/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, write: if isAdmin();
    }

    // Which cafes each waiter login belongs to.
    match /waiterIndex/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, write: if isAdmin();
    }

    match /cafes/{cafeId} {
      // Anyone can see a cafe's menu (customers need it).
      allow read: if true;
      // Only the admin creates or deletes cafes.
      allow create, delete: if isAdmin();
      // Staff can change the menu, name, tables, and pause orders. Nothing else.
      allow update: if isAdmin() || (isStaff(cafeId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'tables', 'menu', 'categories', 'acceptingOrders', 'settings', 'updatedAt', 'popular', 'popularAt', 'photosV'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.tables is int
        && request.resource.data.tables >= 1 && request.resource.data.tables <= 100
        && request.resource.data.menu is list && request.resource.data.menu.size() <= 300
        && request.resource.data.categories is list && request.resource.data.categories.size() <= 40
        && request.resource.data.acceptingOrders is bool
        && (!('settings' in request.resource.data) || request.resource.data.settings is map));

      match /staff/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow list, write: if isAdmin();
      }

      // Waiter logins for this cafe (name shown on their orders).
      match /waiters/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow list, write: if isAdmin();
      }

      match /orders/{orderId} {
        // Customers place orders from their phone. Staff can also type orders in.
        allow create: if validNewOrder(cafeId) || (isStaff(cafeId) && validStaffOrder())
          || (isWaiter(cafeId) && validWaiterOrder(cafeId));
        // Customers follow their own order by its secret id.
        allow get: if true;
        // Only staff and waiters can see the list of all orders.
        allow list: if isStaff(cafeId) || isWaiter(cafeId);
        // Staff can change anything except when the order was placed.
        // A customer can only cancel their own order, and only before the cafe accepts it.
        allow update: if (isStaff(cafeId)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status in ['new', 'preparing', 'ready', 'served', 'rejected', 'cancelled'])
          || (resource.data.status == 'new'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'updatedAt'])
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'customer')
          || (isWaiter(cafeId) && waiterMayChangeOrder());
        allow delete: if isStaff(cafeId);
      }

      // Daily sales totals, kept up to date as bills are saved, so the calendar reads ~30 small records.
      match /days/{day} {
        allow read, write: if isStaff(cafeId);
        // A waiter's payment adds to the day's totals. Waiters can't read the totals back.
        allow create, update: if isWaiter(cafeId)
          && request.resource.data.keys().hasOnly(['month', 'total', 'count', 'gst', 'discount', 'voided', 'pay', 'hours', 'items']);
      }
      // Food photos: everyone can see them, only staff can change them.
      match /media/{docId} {
        allow read: if true;
        allow write: if isStaff(cafeId);
      }
      // Game rooms for customers playing on their own phones. Small, temporary, open to players with the code.
      match /rooms/{code} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['game', 'status', 'host', 'players', 'board', 'turn', 'winner', 'q', 'qs', 'ans', 'deadline', 'createdAt', 'updatedAt'])
          && request.resource.data.game in ['ttt', 'c4', 'quiz']
          && request.resource.data.players is list && request.resource.data.players.size() <= 6;
        allow delete: if true;
      }
      // Game leaderboard. Each phone keeps one best score per game per day (or week).
      // A score can only go up. Staff can hide a name or mark a prize as given.
      match /scores/{sid} {
        allow read: if true;
        allow create: if validScore(sid) && cafe(cafeId).get('games', true) != false;
        allow update: if (validScore(sid) && cafe(cafeId).get('games', true) != false
            && request.resource.data.score > resource.data.score
            && request.resource.data.pidh == resource.data.pidh
            && !('hidden' in resource.data) && !('claimed' in resource.data))
          || (isStaff(cafeId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'claimed']));
        allow delete: if isStaff(cafeId);
      }
      // Bills and the bill number counter: staff only.
      match /bills/{billId} {
        allow read, create, update: if isStaff(cafeId);
        // A waiter can save a bill when taking payment, but can't read, change or void bills.
        allow create: if isWaiter(cafeId) && validWaiterBill();
        // Only the admin can delete bills, when deleting a whole cafe.
        allow delete: if isAdmin();
      }
      match /meta/{docId} {
        allow read, write: if isStaff(cafeId);
        // A waiter can only read the bill number counter and raise it by one when saving a bill.
        allow get: if isWaiter(cafeId) && docId == 'counters';
        allow create: if isWaiter(cafeId) && docId == 'counters'
          && request.resource.data.keys().hasOnly(['billNo']) && request.resource.data.billNo == 1;
        allow update: if isWaiter(cafeId) && docId == 'counters'
          && request.resource.data.keys().hasOnly(['billNo'])
          && request.resource.data.billNo == resource.data.billNo + 1;
      }

      match /calls/{callId} {
        // Customers can call a waiter. Only staff and waiters can see and clear calls.
        allow create: if request.resource.data.keys().hasOnly(['table', 'createdAt'])
          && request.resource.data.table is int
          && request.resource.data.table >= 1
          && request.resource.data.table <= cafe(cafeId).tables
          && request.resource.data.createdAt == request.time;
        allow read, delete: if isStaff(cafeId) || isWaiter(cafeId);
      }
    }
  }
}
